# Copy to .env (never commit .env). Read by every script in this folder.

# Your deployed worker, no trailing slash.
SELLSTUFF_WORKER_URL=https://YOUR_WORKER_URL

# Same value you set as the worker's ADMIN_KEY secret.
SELLSTUFF_ADMIN_KEY=paste-the-long-random-string-here

# Optional.
# SELLSTUFF_PROFILE_DIR=C:\path\to\a\chrome-profile-folder
# SELLSTUFF_IDLE_MS=60000
# SELLSTUFF_WATCH=1
